# Copy this file to .env and set the password you chose during PostgreSQL setup.
POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Enter a real password to use PostgreSQL. Leave it empty only when deliberately
# using the SQLite development fallback below.
# USE_SQLITE=true
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=30
# OpenRouter is attempted only if Ollama fails. Keep real keys only in .env.
OPENROUTER_NVIDIA_API_KEY=
OPENROUTER_NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_GEMMA_API_KEY=
OPENROUTER_GEMMA_MODEL=google/gemma-3-27b-it:free
OPENROUTER_CHATGPT_API_KEY=
OPENROUTER_CHATGPT_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT=45
